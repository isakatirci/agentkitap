# Bu dosyayi .env olarak kopyalayabilirsiniz.
# Kurs ucretli bir API anahtari istemez. Degerler sadece isim gostermek icindir.

# Duz metin lablarinda Gemma. Bu Ollama surumu gemma3:4b ile tool kabul etmez.
MODEL=gemma3:4b
# Tool calling lablarinda Qwen. Yereldir, ucretli anahtar gerekmez.
TOOL_MODEL=qwen2.5:3b

# Isteginiz olursa LangSmith trace'i acmak icin. Bos birakilirsa yerel tracer yeter.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-course

# Isteginiz olursa Tavily aramasina gecmek icin. Lablar yerel corpus kullanir.
TAVILY_API_KEY=
